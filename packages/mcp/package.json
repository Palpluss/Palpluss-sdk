{
  "name": "@palpluss/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "PalPluss MCP server \u2014 let AI coding tools check balances, manage payment channels and wallets, collect with M-Pesa STK Push and send B2C payouts, with human approval on anything that moves money.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "palpluss-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "EMBEDDING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "release:manual": "node scripts/publish.mjs"
  },
  "keywords": [
    "palpluss",
    "mpesa",
    "m-pesa",
    "mcp",
    "model-context-protocol",
    "stk-push",
    "b2c",
    "payments",
    "kenya"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/palpluss/palpluss-sdk.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
